# Kopieren nach server/.env und ausfüllen. Die Datei .env nie committen.

# Pflicht: API-Schlüssel aus der Anthropic-Konsole (console.anthropic.com). Dort auch ein monatliches Ausgabenlimit setzen.
ANTHROPIC_API_KEY=

# Adressen, von denen die App Anfragen schicken darf (kommagetrennt).
ALLOWED_ORIGINS=https://ohyannik-star.github.io

# Header, in dem der vorgeschaltete Dienst die echte Absender-IP mitschickt. Cloudflare Tunnel: cf-connecting-ip, Caddy oder nginx: x-forwarded-for.
TRUST_PROXY_HEADER=cf-connecting-ip

# Grenzen gegen Missbrauch und Kosten.
LIMIT_PRO_STUNDE=5
LIMIT_PRO_TAG=50

# Tage, nach denen beantwortete oder gescheiterte Anfragen gelöscht werden.
AUFBEWAHRUNG_TAGE=90

# 1 = Testmodus: fester Beispiel-Entwurf ohne KI und ohne Kosten.
MOCK_CLAUDE=0

# Optional: Telegram-Nachricht bei jeder neuen Anfrage (Bot über @BotFather anlegen, Chat-ID z. B. über @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Token eines Cloudflare Tunnels (Zero Trust, Networks, Tunnels), wenn das Profil "tunnel" genutzt wird.
TUNNEL_TOKEN=
