# Kopieren nach server/.env und ausfüllen (einrichten.sh macht das automatisch). Die Datei .env nie committen.

# Pflicht für echte Entwürfe: API-Schlüssel aus der Anthropic-Konsole (console.anthropic.com).
# Dort unbedingt ein monatliches Ausgabenlimit setzen, zum Beispiel 20 Dollar. Ein Entwurf kostet grob 12 Cent.
ANTHROPIC_API_KEY=

# Adressen, von denen die App Anfragen schicken darf (kommagetrennt).
ALLOWED_ORIGINS=https://ohyannik-star.github.io

# Header mit der echten Absender-IP vom vorgeschalteten Dienst. Cloudflare-Tunnel: cf-connecting-ip.
# Eigener Proxy (Caddy, nginx): x-forwarded-for; der Server nimmt dann den letzten Eintrag, den der Proxy selbst anhängt.
TRUST_PROXY_HEADER=cf-connecting-ip

# Grenzen gegen Missbrauch und Kosten. 0 bei LIMIT_PRO_TAG pausiert die Funktion.
LIMIT_PRO_STUNDE=2
LIMIT_PRO_TAG_PRO_ABSENDER=3
LIMIT_PRO_TAG=10
MAX_PARALLEL=3

# Tage, nach denen beantwortete oder gescheiterte Anfragen gelöscht werden, und Höchstdauer für unbeantwortete Entwürfe.
AUFBEWAHRUNG_TAGE=90
MAX_OFFEN_TAGE=180

# 1 = Testmodus: fester, als Test markierter Beispiel-Entwurf ohne KI und ohne Kosten.
MOCK_CLAUDE=0

# Optional: Telegram-Nachricht bei jeder neuen Anfrage, nur mit Status und Nummer, ohne den Satz
# (Bot über @BotFather anlegen, Chat-ID z. B. über @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
